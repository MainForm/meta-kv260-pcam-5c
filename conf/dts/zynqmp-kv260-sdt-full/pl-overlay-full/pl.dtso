                xlnx,s2mm-sof-enable = <0x1>;
                interrupt-names = "s2mm_introut";
                xlnx,enable-s2mm-rst-out = <0x0>;
                xlnx,dynamic-resolution = <0x1>;
                xlnx,enable-all = <0x0>;
                xlnx,m-axis-mm2s-tdata-width = <0x20>;
                xlnx,enable-mm2s-frm-counter = <0x1>;
