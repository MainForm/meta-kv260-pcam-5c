                xlnx,enable-s2mm-fsync-out = <0x0>;
                reg = <0x0 0xa0020000 0x0 0x10000>;
                xlnx,s2mm-genlock-num-masters = <0x1>;
                xlnx,ip-name = "axi_vdma";
                xlnx,enable-s2mm-buf-full = <0x0>;
                xlnx,dlytmr-resolution = <0x7d>;
                xlnx,enable-mm2s-delay-counter = <0x1>;
                xlnx,enable-s2mm-frm-counter = <0x1>;
                xlnx,enable-debug-info-9 = <0x0>;

                dma_channel_a0020030: dma-channel@a0020030 {
                        xlnx,genlock-mode;
                        compatible = "xlnx,axi-vdma-s2mm-channel";
                        xlnx,device-id = <0x0>;
                        xlnx,datawidth = <0x10>;
                        interrupts = <0x0 0x5b 0x4>;
                };
        };

        mipi_csi2_rx_subsyst_0: mipi_csi2_rx_subsystem@a0030000 {
