/dts-v1/;
/plugin/;

&fpga_full {
        firmware-name = "system_bd_wrapper.bit.bin";

        misc_clk_0: misc_clk_0 {
                #clock-cells = <0x0>;
                clocks = <&zynqmp_clk 0x47>;
                clock-mult = <0x7d0>;
                compatible = "fixed-factor-clock";
                clock-div = <0x3e8>;
        };

        misc_clk_1: misc_clk_1 {
                #clock-cells = <0x0>;
                clocks = <&zynqmp_clk 0x47>;
                clock-mult = <0x474>;
                compatible = "fixed-factor-clock";
                clock-div = <0x3e8>;
        };

        clocking1: clocking1 {
                clocks = <&zynqmp_clk 0x48>;
                clock-output-names = "fabric_clk";
                #clock-cells = <0x0>;
                assigned-clock-rates = <0x5f5dd19>;
                assigned-clocks = <&zynqmp_clk 0x48>;
                compatible = "xlnx,fclk";
        };

        clocking0: clocking0 {
                clocks = <&zynqmp_clk 0x47>;
                clock-output-names = "fabric_clk";
                #clock-cells = <0x0>;
                assigned-clock-rates = <0x5f5dd19>;
                assigned-clocks = <&zynqmp_clk 0x47>;
                compatible = "xlnx,fclk";
        };

        afi0: afi0 {
                config-afi = <0x0 0x0 0x1 0x0 0x2 0x0 0x3 0x0 0x4 0x0 0x5 0x0 0x6 0x0 0x7 0x0 0x8 0x0 0x9 0x0 0xa 0x0 0xb 0x0 0xc 0x0 0xd 0x0 0xe 0xa00 0xf 0x0>;
                resets = <&zynqmp_reset 0x74>,
                 <&zynqmp_reset 0x75>,
                 <&zynqmp_reset 0x76>,
                 <&zynqmp_reset 0x77>;
                compatible = "xlnx,afi-fpga";
        };
};

&amba {

        axi_gpio_0: gpio@a0010000 {
                xlnx,all-inputs = <0x0>;
                xlnx,name = "axi_gpio_0";
                xlnx,tri-default = <0xffffffff>;
                clock-names = "s_axi_aclk";
                xlnx,gpio2-width = <0x20>;
                xlnx,dout-default-2 = <0x0>;
                xlnx,edk-iptype = "PERIPHERAL";
                xlnx,gpio2-board-interface = "Custom";
                xlnx,interrupt-present = <0x0>;
                device_type = "gpio";
                gpio-controller;
                xlnx,all-outputs-2 = <0x0>;
                clocks = <&zynqmp_clk 0x47>;
                xlnx,all-inputs-2 = <0x0>;
                reg = <0x0 0xa0010000 0x0 0x10000>;
                xlnx,tri-default-2 = <0xffffffff>;
                xlnx,ip-name = "axi_gpio";
                xlnx,is-dual = <0x0>;
                xlnx,dout-default = <0x0>;
                xlnx,gpio-width = <0x1>;
                #gpio-cells = <0x2>;
                xlnx,all-outputs = <0x1>;
                compatible = "xlnx,axi-gpio-2.0", "xlnx,xps-gpio-1.00.a";
                xlnx,gpio-board-interface = "Custom";
        };

        axi_iic_0: i2c@a0000000 {
                xlnx,sda-inertial-delay = <0x0>;
                xlnx,axi-aclk-freq-mhz = <0x5f5dd19>;
                xlnx,name = "axi_iic_0";
                xlnx,smbus-pmbus-host = <0x0>;
                xlnx,iic-freq = <0x186a0>;
                xlnx,timing-reg-width = <0x20>;
                xlnx,iic-board-interface = "Custom";
                interrupt-names = "iic2intc_irpt";
                xlnx,default-value = <0x0>;
                xlnx,ten-bit-adr = <0x0>;
                clock-names = "s_axi_aclk";
                xlnx,sda-level = <0x1>;
                xlnx,static-timing-reg-width = <0x0>;
                xlnx,edk-iptype = "PERIPHERAL";
                xlnx,s-axi-aclk-freq-hz = <0x5f5dd19>;
                xlnx,gpo-width = <0x1>;
                clocks = <&zynqmp_clk 0x47>;
                reg = <0x0 0xa0000000 0x0 0x10000>;
                xlnx,disable-setup-violation-check = <0x0>;
                xlnx,ip-name = "axi_iic";
                interrupt-parent = <&gic>;
                xlnx,scl-inertial-delay = <0x0>;
                compatible = "xlnx,axi-iic-2.1", "xlnx,xps-iic-2.00.a";
                xlnx,iic-freq-khz = <0x64>;
                interrupts = <0x0 0x59 0x4>;
        };

        axi_vdma_0: dma@a0020000 {
                xlnx,enable-mm2s-buf-empty = <0x0>;
                xlnx,enable-debug-info-8 = <0x0>;
                xlnx,use-s2mm-fsync = <0x2>;
                xlnx,enable-debug-info-7 = <0x1>;
                xlnx,enable-debug-info-6 = <0x1>;
                xlnx,mm2s-tdata-width = <0x20>;
                xlnx,enable-debug-info-5 = <0x0>;
                xlnx,enable-debug-info-4 = <0x0>;
                xlnx,enable-s2mm-delay-counter = <0x1>;
                xlnx,enable-debug-info-3 = <0x0>;
                xlnx,enable-mm2s-param-updt = <0x0>;
                xlnx,enable-debug-info-2 = <0x0>;
                xlnx,mm2s-data-width = <0x40>;
                xlnx,enable-debug-info-1 = <0x0>;
                xlnx,enable-debug-all = <0x0>;
                xlnx,enable-debug-info-0 = <0x0>;
                xlnx,mm2s-genlock-mode = <0x0>;
                xlnx,enable-vidprmtr-reads = <0x1>;
                #dma-cells = <0x1>;
                xlnx,s2mm-tdata-width = <0x10>;
                xlnx,prmry-is-aclk-async = <0x0>;
                xlnx,mm2s-genlock-repeat-en = <0x0>;
                xlnx,enable-vidparam-reads = <0x1>;
                xlnx,enable-s2mm-param-updt = <0x0>;
                xlnx,num-fstores = <0x3>;
                xlnx,s2mm-data-width = <0x80>;
                xlnx,select-xpm = <0x0>;
                xlnx,flush-fsync = <0x1>;
                xlnx,s2mm-genlock-mode = <0x2>;
                xlnx,include-mm2s = <0x0>;
                xlnx,mm2s-linebuffer-depth = <0x200>;
                xlnx,enable-debug-info-15 = <0x1>;
                clock-names = "m_axi_s2mm_aclk", "s_axi_lite_aclk", "s_axis_s2mm_aclk";
                xlnx,include-internal-genlock = <0x1>;
                xlnx,enable-debug-info-14 = <0x1>;
                xlnx,include-mm2s-sf = <0x0>;
                xlnx,enable-vert-flip = <0x0>;
                xlnx,enable-debug-info-13 = <0x0>;
                xlnx,s2mm-genlock-repeat-en = <0x1>;
                xlnx,use-fsync = <0x1>;
                xlnx,enable-debug-info-12 = <0x0>;
                xlnx,edk-iptype = "PERIPHERAL";
                xlnx,enable-debug-info-11 = <0x0>;
                xlnx,addrwidth = <0x20>;
                xlnx,enable-debug-info-10 = <0x0>;
                xlnx,s-axis-s2mm-tdata-width = <0x10>;
                clocks = <&misc_clk_0>,
                 <&zynqmp_clk 0x47>,
                 <&misc_clk_0>;
                xlnx,addr-width = <0x20>;
                xlnx,include-s2mm = <0x1>;
                xlnx,s2mm-linebuffer-depth = <0x200>;
                xlnx,single-interface = <0x0>;
                xlnx,include-s2mm-sf = <0x1>;
                xlnx,flush-on-fsync = <0x1>;
                xlnx,m-axi-mm2s-data-width = <0x40>;
                interrupts = <0x0 0x5b 0x4>;
                xlnx,enable-mm2s-frmstr-reg = <0x0>;
                xlnx,name = "axi_vdma_0";
                xlnx,include-mm2s-dre = <0x0>;
                xlnx,mm2s-max-burst-length = <0x8>;
                xlnx,enable-s2mm-sts-reg = <0x0>;
                xlnx,m-axi-s2mm-data-width = <0x80>;
                xlnx,enable-s2mm-frmstr-reg = <0x0>;
                xlnx,include-s2mm-dre = <0x0>;
                xlnx,mm2s-sof-enable = <0x1>;
                xlnx,enable-mm2s-rst-out = <0x0>;
                xlnx,s2mm-max-burst-length = <0x8>;
                interrupt-parent = <&gic>;
                xlnx,enable-tstvec = <0x0>;
                compatible = "xlnx,axi-vdma-6.3", "xlnx,axi-vdma-1.00.a";
                xlnx,mm2s-linebuffer-thresh = <0x4>;
